# Development Dockerfile for SyftHub Frontend
# Build with context: .. (repository root, from components/frontend)
FROM node:20-alpine

# The frontend's API client lives in components/frontend/sdk and is a "file:sdk" dependency:
# build it first so dist/ exists.
WORKDIR /app/components/frontend/sdk
COPY components/frontend/sdk ./
RUN npm ci --ignore-scripts && npm run build

# Set working directory for frontend (mirrors repo: components/frontend)
WORKDIR /app/components/frontend

# Copy frontend package.json and lockfile
COPY components/frontend/package.json components/frontend/package-lock.json ./

# Install dependencies (skip postinstall: husky needs .git, playwright downloads ~200MB of browsers)
RUN npm ci --ignore-scripts

# Copy frontend source code
COPY components/frontend/ .

# Expose development server port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3000/ || exit 1

# Start development server
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
